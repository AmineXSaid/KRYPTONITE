# Line endings are normalised to LF in the repository. Windows checkouts keep
# whatever core.autocrlf says locally, and the index never sees CRLF, so a
# clone on another platform does not show every file as modified.
* text=auto

# Binaries git must never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.vsix binary
*.xlsx binary
*.docx binary
*.pptx binary
*.mp4 binary
*.webm binary
