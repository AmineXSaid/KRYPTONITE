# ── read-only MCP servers: configuration ─────────────────────────────────────
# Copy to .env and fill in. NEVER commit the filled-in copy.
# This file contains no secrets and is safe to commit.
#
# One rule covers every variable below: a setting is read as <PREFIX>_NAME
# first and MCP_NAME second. So MCP_CA_BUNDLE set once covers all four
# servers, while JENKINS_READ_TIMEOUT still wins for the one whose console
# fetches are slow. Only the credentials have no shared form - four services
# do not share a token.

# ═══ Atlassian (jira-mcp, confluence-mcp) ════════════════════════════════════
#
# One prefix for both, because a corporate instance issues one credential per
# user that works against both products. Two copies of it would only drift.

# Instance roots. Root only - no /rest path, no trailing slash.
# Data Center examples:
JIRA_BASE_URL=https://jira.company.internal
CONFLUENCE_BASE_URL=https://confluence.company.internal
# Confluence Cloud would be https://your-site.atlassian.net/wiki (note /wiki).

# bearer = Data Center Personal Access Token  (ATLASSIAN_TOKEN alone)
# basic  = Cloud email + API token            (ATLASSIAN_USER + ATLASSIAN_TOKEN)
# Run probe.py if you are not sure which deployment you are on.
ATLASSIAN_AUTH_MODE=bearer

# Your OWN credential. Not a service account, not a shared token.
# Data Center: Profile -> Personal Access Tokens -> Create token.
# Cloud:       id.atlassian.com -> API tokens.
ATLASSIAN_TOKEN=

# basic mode only: your account email. Leave blank in bearer mode.
ATLASSIAN_USER=

# ═══ GitLab (gitlab-mcp) ═════════════════════════════════════════════════════
#
# Self-managed GitLab takes the token in PRIVATE-TOKEN, not in Authorization.
# The same token sent as `Bearer` returns 401 on older instances, which looks
# exactly like a bad token - so the header name is fixed rather than guessed.
GITLAB_BASE_URL=https://gitlab.company.internal
GITLAB_AUTH_MODE=header

# A Personal Access Token with the read_api scope. read_api is enough for
# everything these tools do, and api would grant write - do not use it.
GITLAB_TOKEN=

# ═══ Jenkins (jenkins-mcp) ═══════════════════════════════════════════════════
#
# Jenkins has no PAT; it takes your username plus an API token as HTTP Basic.
JENKINS_BASE_URL=https://jenkins.company.internal
JENKINS_AUTH_MODE=basic

# Your Jenkins login, and an API token from your user page ->
# Configure -> API Token. Not your password.
JENKINS_USER=
JENKINS_TOKEN=

# ═══ shared, optional ════════════════════════════════════════════════════════

# Corporate root CA, if your instances use internally-signed certificates.
# A PEM bundle. There is no option to disable verification, by design.
# One CA usually signs all four hosts, which is what the shared form is for.
MCP_CA_BUNDLE=
# ATLASSIAN_CA_BUNDLE=   # overrides MCP_CA_BUNDLE for Jira/Confluence only

# Standard proxy variables are honoured automatically; set them only if your
# environment needs them. An internal host usually belongs in NO_PROXY.
# HTTPS_PROXY=http://proxy.company.internal:8080
# NO_PROXY=.company.internal,localhost,127.0.0.1

# Page-size ceiling. Default 50, hard maximum 100 (not configurable above that).
MCP_MAX_RESULTS_CAP=50

# Timeouts in seconds. Defaults: connect 10, read 30.
# A Jenkins console log is the one call that regularly needs longer.
# MCP_CONNECT_TIMEOUT=10
# MCP_READ_TIMEOUT=30
# JENKINS_READ_TIMEOUT=120
